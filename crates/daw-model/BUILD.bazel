load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "daw-model",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "daw_model",
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "unit_test",
    crate = ":daw-model",
)

rust_binary(
    name = "demo_project",
    srcs = ["examples/demo_project.rs"],
    deps = [":daw-model"] + all_crate_deps(normal = True),
)
