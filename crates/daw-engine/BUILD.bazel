load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "daw-engine",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "daw_engine",
    deps = ["//crates/daw-model"] + all_crate_deps(normal = True),
)

rust_test(
    name = "unit_test",
    crate = ":daw-engine",
)

rust_test(
    name = "render_test",
    srcs = ["tests/render.rs"],
    deps = [
        ":daw-engine",
        "//crates/daw-model",
    ] + all_crate_deps(normal = True),
)
